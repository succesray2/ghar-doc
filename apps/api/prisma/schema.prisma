generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum VisitStatus {
  REQUESTED
  ASSIGNED
  PROVIDER_ACCEPTED
  PROVIDER_DECLINED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_PROVIDER_AVAILABLE
}

enum RevokedReason {
  ROTATED
  REUSE_DETECTED
  USER_LOGOUT
  USER_LOGOUT_ALL
  PASSWORD_CHANGE
}

enum NotificationCategory {
  BOOKING_UPDATE
  PROVIDER_ASSIGNMENT
  PROVIDER_ARRIVAL
  SERVICE_UPDATE
  PAYMENT_UPDATE
  GENERAL
}

enum FamilyRelation {
  PARENT
  SPOUSE
  CHILD
  OTHER
}

enum VisitPaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DoctorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum TriagePriority {
  GREEN
  ORANGE
  RED
}

enum BookingRelation {
  SELF
  PARENT
  SPOUSE
  CHILD
  OTHER_FAMILY
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  role                Role
  firstName           String
  lastName            String
  phone               String?
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Reserved for a future TOTP implementation — no verification flow
  // exists yet, these are unused by every current code path.
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  patientProfile         PatientProfile?
  doctorProfile          DoctorProfile?
  refreshTokens          RefreshToken[]
  visitsAsPatient        Visit[]                 @relation("PatientVisits")
  visitsAsDoctor         Visit[]                 @relation("DoctorVisits")
  visitStatusEvents      VisitStatusEvent[]
  doctorStatusEvents     DoctorStatusEvent[]
  familyMembers          FamilyMember[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
}

model PatientProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  addressLine1     String
  addressLine2     String?
  city             String
  state            String
  postalCode       String
  lat              Float?
  lng              Float?
  dateOfBirth      DateTime?
  gender           String?
  emergencyContact String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model DoctorProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id])
  licenseNumber   String
  specialty       String
  bio             String?
  yearsExperience Int?
  status          DoctorStatus @default(PENDING)
  statusReason    String?
  reviewedAt      DateTime?
  isAvailable     Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  statusEvents DoctorStatusEvent[]
}

// Audit trail of every doctor verification decision — same pattern as
// VisitStatusEvent. Powers the admin "Doctor Applications" review screen.
model DoctorStatusEvent {
  id              String        @id @default(cuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  fromStatus      DoctorStatus?
  toStatus        DoctorStatus
  reason          String?
  changedById     String
  changedBy       User          @relation(fields: [changedById], references: [id])
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now())
}

model Visit {
  id                 String             @id @default(cuid())
  patientId          String
  patient            User               @relation("PatientVisits", fields: [patientId], references: [id])
  doctorId           String?
  doctor             User?              @relation("DoctorVisits", fields: [doctorId], references: [id])
  status             VisitStatus        @default(REQUESTED)
  paymentStatus      VisitPaymentStatus @default(UNPAID)
  priority           TriagePriority     @default(GREEN)
  bookingFor         BookingRelation    @default(SELF)
  patientName        String?
  patientAge         Int?
  patientSex         String?
  caregiverName      String?
  caregiverPhone     String?
  reasonForVisit     String
  notes              String?
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  postalCode         String
  lat                Float?
  lng                Float?
  requestedAt        DateTime           @default(now())
  assignedAt         DateTime?
  acceptedAt         DateTime?
  enRouteAt          DateTime?
  arrivedAt          DateTime?
  inProgressAt       DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  statusEvents       VisitStatusEvent[]
  triage             VisitTriage?
  notifications      Notification[]

  @@index([status])
  @@index([patientId])
  @@index([doctorId])
  @@index([priority])
}

// Permanent audit record of the safety-triage answers and classification
// for one visit. Never edited after creation — a future rule-version bump
// must never rewrite historical classifications, only affect new visits.
// NOT a clinical diagnosis: `priority` is a service-dispatch signal only.
model VisitTriage {
  id                  String         @id @default(cuid())
  visitId             String         @unique
  visit               Visit          @relation(fields: [visitId], references: [id])
  ruleVersion         Int
  answers             Json
  priority            TriagePriority
  matchedRedFlags     Json?
  redFlagAcknowledged Boolean        @default(false)
  createdAt           DateTime       @default(now())
}

// Audit trail of every status change. Powers the admin activity view today
// and is what a future notifications module would subscribe to.
model VisitStatusEvent {
  id          String       @id @default(cuid())
  visitId     String
  visit       Visit        @relation(fields: [visitId], references: [id])
  fromStatus  VisitStatus?
  toStatus    VisitStatus
  changedById String
  changedBy   User         @relation(fields: [changedById], references: [id])
  note        String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())
}

model RefreshToken {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  tokenHash     String         @unique
  familyId      String
  userAgent     String?
  ip            String?
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason RevokedReason?
  createdAt     DateTime       @default(now())

  @@index([familyId])
  @@index([userId, revokedAt])
}

// One row per patient-managed family member, used for the "who needs care"
// booking step. Real, persisted — replaces the earlier session-local mock.
model FamilyMember {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  name      String
  relation  FamilyRelation
  age       Int?
  phone     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

// A single in-app notification. Real and persisted — this is the only
// delivery channel today (no SMS/push provider is configured); creation is
// gated by NotificationPreference at write time, not just stored inertly.
model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  category  NotificationCategory
  title     String
  body      String
  visitId   String?
  visit     Visit?               @relation(fields: [visitId], references: [id])
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  bookingUpdates       Boolean  @default(true)
  providerAssignment   Boolean  @default(true)
  providerArrival      Boolean  @default(true)
  serviceUpdates       Boolean  @default(true)
  paymentUpdates       Boolean  @default(true)
  generalNotifications Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
