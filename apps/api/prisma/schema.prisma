generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum VisitStatus {
  REQUESTED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VisitPaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DoctorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum TriagePriority {
  GREEN
  ORANGE
  RED
}

enum BookingRelation {
  SELF
  PARENT
  SPOUSE
  CHILD
  OTHER_FAMILY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile     PatientProfile?
  doctorProfile      DoctorProfile?
  refreshTokens      RefreshToken[]
  visitsAsPatient    Visit[]             @relation("PatientVisits")
  visitsAsDoctor     Visit[]             @relation("DoctorVisits")
  visitStatusEvents  VisitStatusEvent[]
  doctorStatusEvents DoctorStatusEvent[]
}

model PatientProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  addressLine1     String
  addressLine2     String?
  city             String
  state            String
  postalCode       String
  lat              Float?
  lng              Float?
  dateOfBirth      DateTime?
  gender           String?
  emergencyContact String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model DoctorProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id])
  licenseNumber   String
  specialty       String
  bio             String?
  yearsExperience Int?
  status          DoctorStatus @default(PENDING)
  statusReason    String?
  reviewedAt      DateTime?
  isAvailable     Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  statusEvents DoctorStatusEvent[]
}

// Audit trail of every doctor verification decision — same pattern as
// VisitStatusEvent. Powers the admin "Doctor Applications" review screen.
model DoctorStatusEvent {
  id              String        @id @default(cuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  fromStatus      DoctorStatus?
  toStatus        DoctorStatus
  reason          String?
  changedById     String
  changedBy       User          @relation(fields: [changedById], references: [id])
  createdAt       DateTime      @default(now())
}

model Visit {
  id                 String             @id @default(cuid())
  patientId          String
  patient            User               @relation("PatientVisits", fields: [patientId], references: [id])
  doctorId           String?
  doctor             User?              @relation("DoctorVisits", fields: [doctorId], references: [id])
  status             VisitStatus        @default(REQUESTED)
  paymentStatus      VisitPaymentStatus @default(UNPAID)
  priority           TriagePriority     @default(GREEN)
  bookingFor         BookingRelation    @default(SELF)
  patientName        String?
  patientAge         Int?
  patientSex         String?
  caregiverName      String?
  caregiverPhone     String?
  reasonForVisit     String
  notes              String?
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  postalCode         String
  lat                Float?
  lng                Float?
  requestedAt        DateTime           @default(now())
  assignedAt         DateTime?
  enRouteAt          DateTime?
  inProgressAt       DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  statusEvents       VisitStatusEvent[]
  triage             VisitTriage?

  @@index([status])
  @@index([patientId])
  @@index([doctorId])
  @@index([priority])
}

// Permanent audit record of the safety-triage answers and classification
// for one visit. Never edited after creation — a future rule-version bump
// must never rewrite historical classifications, only affect new visits.
// NOT a clinical diagnosis: `priority` is a service-dispatch signal only.
model VisitTriage {
  id                  String         @id @default(cuid())
  visitId             String         @unique
  visit               Visit          @relation(fields: [visitId], references: [id])
  ruleVersion         Int
  answers             Json
  priority            TriagePriority
  matchedRedFlags     Json?
  redFlagAcknowledged Boolean        @default(false)
  createdAt           DateTime       @default(now())
}

// Audit trail of every status change. Powers the admin activity view today
// and is what a future notifications module would subscribe to.
model VisitStatusEvent {
  id          String       @id @default(cuid())
  visitId     String
  visit       Visit        @relation(fields: [visitId], references: [id])
  fromStatus  VisitStatus?
  toStatus    VisitStatus
  changedById String
  changedBy   User         @relation(fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime     @default(now())
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}
